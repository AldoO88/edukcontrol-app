# =====================================================================
# Plantilla de variables de entorno para la app móvil EdukControl.
# ---------------------------------------------------------------------
# Copia este archivo a `.env` y reemplaza los valores según tu entorno:
#
#   cp .env.example .env
#
# Las variables con prefijo `EXPO_PUBLIC_` se exponen al bundle del
# cliente y se leen en runtime vía `process.env.EXPO_PUBLIC_*`.
# Para inyectarlas también en runtime del cliente JS (axios, push, etc)
# anteponé siempre EXPO_PUBLIC_.
#
# Para producción, exponé estas variables en
# `eas env create --environment production --name EXPO_PUBLIC_API_URL --value ...`
# o usa `.env.production` en la raíz del proyecto.
# =====================================================================

# URL del backend que la app consumirá.
#   - dev local (device físico en tu Wi-Fi):
#       EXPO_PUBLIC_API_URL=http://192.168.100.52:5050
#   - staging:
#       EXPO_PUBLIC_API_URL=https://api-staging.edukcontrol.mx
#   - producción:
#       EXPO_PUBLIC_API_URL=https://api.edukcontrol.mx
EXPO_PUBLIC_API_URL=http://192.168.100.52:5050
